{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::{Password}:role/cross-account-s3-role"
      },
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::bootcamp-assignment-4a-s3-demo-bucket",
        "arn:aws:s3:::bootcamp-assignment-4a-s3-demo-bucket/*"
      ]
    }
  ]
}
