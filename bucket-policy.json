{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::{Password}:user/s3-test-user"
      },
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::bootcamp-assignment-4a-s3-demo-bucket-2",
        "arn:aws:s3:::bootcamp-assignment-4a-s3-demo-bucket-2/*"
      ]
    }
  ]
}
